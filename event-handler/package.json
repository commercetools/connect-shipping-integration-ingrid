{
  "name": "shipping-integration-ingrid",
  "version": "3.3.5",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node build/index.js",
    "gcp-build": "tsc",
    "start:dev": "concurrently -k \"tsc --watch\" \"nodemon -q build/index.js\"",
    "build": "rimraf ./build && tsc",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src test",
    "prettier": "prettier --write '**/*.{js,ts}'",
    "check": "tsc --noEmit && npm run lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --detectOpenHandles",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --collectCoverageFrom='src/**/*.ts'",
    "connector:post-deploy": "node build/connector/post-deploy.js",
    "connector:pre-undeploy": "node build/connector/pre-undeploy.js"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.34.0",
    "@jest/globals": "30.4.1",
    "@tsconfig/recommended": "^1.0.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^9.2.1",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "^16.3.0",
    "jest": "^30.4.2",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@commercetools-backend/loggers": "^24.5.0",
    "@commercetools/platform-sdk": "^8.15.0",
    "@commercetools/ts-client": "^4.1.0",
    "axios": "^1.19.0",
    "body-parser": "^2.3.0",
    "dotenv": "^17.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.2.1",
    "listr2": "^9.0.2",
    "validator": "^13.15.35"
  }
}
